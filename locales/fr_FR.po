msgstr "Ouvrir le nouveau ticket"

msgid "Please select a destination entity."
msgstr "Veuillez sélectionner une entité de destination."

msgid "Propagate"
msgstr "Propager"

msgid "Propagate this ticket to another entity"
msgstr "Propager ce ticket vers une autre entité"

msgid "Propagate ticket #"
msgstr "Propager le ticket #"

msgid "Propagate to entity"
msgstr "Propager vers une entité"

msgid "Propagating..."
msgstr "Propagation en cours..."

msgid "Requester"
msgstr "Demandeur"

msgid "The destination ticket could not be created."
msgstr "Le ticket de destination n'a pas pu être créé."

