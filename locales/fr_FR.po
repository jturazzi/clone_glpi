msgid "%d not copied"
msgstr "%d non copiés"

msgid "%d not valid in destination entity"
msgstr "%d non valides dans l'entité de destination"

msgid "All %s(s) are valid in the destination entity."
msgstr "Tous les %s(s) sont valides dans l'entité de destination."

msgid "All assigned group(s) are visible in the destination entity."
msgstr "Tous les groupes assignés sont visibles dans l'entité de destination."

msgid "An unexpected error occurred. Check the GLPI log for details."
