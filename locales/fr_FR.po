msgid "Ticket successfully cloned (new ticket #%d)."
msgstr "Ticket cloné avec succès (nouveau ticket #%d)."

msgid "Unable to open the propagation dialog. Check browser console."
msgstr "Impossible d'ouvrir la fenêtre de propagation. Vérifiez la console du navigateur."

msgid "Unknown error."
msgstr "Erreur inconnue."

msgid "What will happen"
msgstr "Ce qui va se passer"

msgid "You do not have access to the destination entity."
msgstr "Vous n'avez pas accès à l'entité de destination."

msgid "You do not have access to this ticket."
msgstr "Vous n'avez pas accès à ce ticket."

msgid "You do not have the required rights."
msgstr "Vous n'avez pas les droits nécessaires."
