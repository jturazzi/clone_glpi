msgstr "Bootstrap n'est pas disponible sur cette page. Veuillez recharger la page."

msgid "Cancel"
msgstr "Annuler"

msgid "Category"
msgstr "Catégorie"

msgid "Category is not visible in the destination entity."
msgstr "La catégorie n'est pas visible dans l'entité de destination."

msgid "Category is visible in the destination entity."
msgstr "La catégorie est visible dans l'entité de destination."

msgid "Checking what will carry over..."
msgstr "Vérification de ce qui sera conservé..."

msgid "Cleared"
msgstr "Effacé"

